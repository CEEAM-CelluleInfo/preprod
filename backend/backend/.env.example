# ---- Django core ----
DJANGO_SECRET_KEY=changeme-generate-a-long-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.ceaam.org,localhost,127.0.0.1

# ---- Database (Postgres conteneurisé, service "db") ----
DB_NAME=ceeam
DB_USER=ceeam_app
DB_PASSWORD=changeme-strong-password
DB_HOST=db
DB_PORT=5432
DB_SSLMODE=disable
USE_POSTGRES=True

# ---- Redis / Celery ----
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
DJANGO_CACHE_URL=redis://redis:6379/2

# ---- Stockage média ----
# L'ancien bucket S3 AWS n'est plus utilisable (compte AWS desactive, cf.
# DEVOPS-HANDOFF.md). Stockage local sur le Droplet par defaut (volume Docker
# "media_volume"). Remettre USE_S3=True + les cles AWS_* si un stockage S3
# (ou compatible S3 : Cloudflare R2, DO Spaces) est reconfigure plus tard.
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_QUERYSTRING_AUTH=True

# ---- Email (Resend, API HTTPS — le port SMTP 587 est bloqué en sortie chez la plupart des hebergeurs cloud) ----
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=CEEAM<no-reply@ceaam.org>
FRONTEND_URL=https://ceaam.org
